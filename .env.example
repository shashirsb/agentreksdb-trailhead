# Copy to .env (never commit it). Everything except DATABASE_URL is optional for a local run.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trailhead
TRAILHEAD_BIND=127.0.0.1:8080
TRAILHEAD_PUBLIC_URL=http://127.0.0.1:8080

# Local only: password-less sign-in and governor decisions outside the Sun->Fri window.
TRAILHEAD_DEV_LOGIN=0
TRAILHEAD_ENFORCE_WINDOW=1

# Interim governing body (GitHub logins, comma separated) until the first election.
TRAILHEAD_GOVERNORS=shashirsb

# Which repo intents change, and where the signing workflow lives.
TRAILHEAD_TARGET_REPO=shashirsb/agentreksdb-trailhead-helloworld
TRAILHEAD_REPO=shashirsb/agentreksdb-trailhead
TRAILHEAD_BOT_LOGIN=agentreks-trailhead[bot]

# GitHub App (push, PRs, webhooks) + its OAuth client (sign-in).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/trailhead-app.pem
GITHUB_INSTALLATION_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Bearer token the target repo's train-tick job sends to POST /api/train/tick.
TRAILHEAD_TICK_TOKEN=
# Ledger checkpoint signing key: generate with `trailhead keygen`.
TRAILHEAD_LEDGER_KEY=

# Model access. The interviewer uses it directly; generation uses it only inside the sandbox proxy.
ANTHROPIC_API_KEY=
# dry-run (default) writes the spec as a doc; command runs TRAILHEAD_SANDBOX_COMMAND per intent.
TRAILHEAD_SANDBOX=dry-run
TRAILHEAD_SANDBOX_COMMAND=deploy/sandbox/launch.sh
TRAILHEAD_WORK_DIR=/var/lib/trailhead/runs
# Global circuit breaker: generation pauses for the day once this many credits are spent.
TRAILHEAD_DAILY_BUDGET_CREDITS=100000
