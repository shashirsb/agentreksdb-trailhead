# Copy to deploy/prod/.env on the server (chmod 600). Never commit it.
TRAILHEAD_DOMAIN=trailhead.agentreksdb.com
SITE_DOMAIN=www.agentreksdb.com
APEX_DOMAIN=agentreksdb.com
POSTGRES_PASSWORD=change-me-openssl-rand-hex-24

TRAILHEAD_GOVERNORS=shashirsb
# Preferred: numeric GitHub account ids (logins can be renamed). `gh api users/shashirsb -q .id`
TRAILHEAD_GOVERNOR_IDS=
TRAILHEAD_TARGET_REPO=shashirsb/agentreksdb-trailhead-helloworld
# Cargo workspace inside the target repo: "." for helloworld, "agentreksdb" for shashirsb/agentreksdb
TRAILHEAD_WORKSPACE_DIR=.
TRAILHEAD_BOT_LOGIN=agentreks-trailhead[bot]

GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
TRAILHEAD_TICK_TOKEN=
TRAILHEAD_LEDGER_KEY=

ANTHROPIC_API_KEY=
TRAILHEAD_PROXY_TOKEN=
TRAILHEAD_SANDBOX=command
TRAILHEAD_SANDBOX_COMMAND=/app/deploy/sandbox/launch.sh
TRAILHEAD_DAILY_BUDGET_CREDITS=5000
