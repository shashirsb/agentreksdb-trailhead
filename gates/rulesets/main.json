{
  "name": "trailhead-main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "merge"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "gate-tests / static",
            "integration_id": 15368
          },
          {
            "context": "gate-tests / nextest",
            "integration_id": 15368
          },
          {
            "context": "gate-tests / coverage",
            "integration_id": 15368
          },
          {
            "context": "gate-tests / mutants",
            "integration_id": 15368
          },
          {
            "context": "gate-perf / instructions",
            "integration_id": 15368
          },
          {
            "context": "gate-diff-policy / policy",
            "integration_id": 15368
          },
          {
            "context": "gate-conformance / scope",
            "integration_id": 15368
          },
          {
            "context": "gate-supply-chain / zizmor",
            "integration_id": 15368
          },
          {
            "context": "gate-supply-chain / osv-scanner",
            "integration_id": 15368
          },
          {
            "context": "gate-supply-chain / cargo-deny",
            "integration_id": 15368
          },
          {
            "context": "gate-supply-chain / lockfile-delta",
            "integration_id": 15368
          },
          {
            "context": "gate-supply-chain / cargo-vet",
            "integration_id": 15368
          },
          {
            "context": "gate-supply-chain / secrets",
            "integration_id": 15368
          },
          {
            "context": "gate-codeql / analyze",
            "integration_id": 15368
          },
          {
            "context": "gate-sabotage / static",
            "integration_id": 15368
          },
          {
            "context": "gate-attestation / verify",
            "integration_id": 15368
          },
          {
            "context": "train-gate",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "merge_queue",
      "parameters": {
        "merge_method": "MERGE",
        "max_entries_to_build": 5,
        "min_entries_to_merge": 1,
        "max_entries_to_merge": 5,
        "min_entries_to_merge_wait_minutes": 5,
        "grouping_strategy": "ALLGREEN",
        "check_response_timeout_minutes": 120
      }
    }
  ]
}
