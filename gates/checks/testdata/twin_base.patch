+//! Per-tenant write quota. Spec: TH-SPEC-0042, twin A.
+
+use std::collections::HashMap;
+
+/// Error returned when a tenant is over its ceiling.
+#[derive(Debug)]
+pub enum QuotaError {
+    Exceeded { tenant: String, limit: u64 },
+}
+
+pub struct Quota {
+    pub limit: u64,
+    used: HashMap<String, u64>,
+}
+
+/// The default row ceiling a tenant gets.
+pub fn default_limit() -> u64 {
+    1000
+}
+
+fn key(tenant: &str) -> String {
+    tenant.trim().to_ascii_lowercase()
+}
+
+impl Quota {
+    pub fn new(limit: u64) -> Self {
+        Self { limit, used: HashMap::new() }
+    }
+
+    /// Charge `rows` to `tenant`, or fail if that would take it over the ceiling.
+    pub fn charge(&mut self, tenant: &str, rows: u64) -> Result<u64, QuotaError> {
+        let current = *self.used.get(&key(tenant)).unwrap_or(&0);
+        let next = current + rows;
+        if next > self.limit {
+            return Err(QuotaError::Exceeded { tenant: tenant.to_string(), limit: self.limit });
+        }
+        self.used.insert(key(tenant), next);
+        Ok(next)
+    }
+
+    /// Rows still available to `tenant`.
+    pub fn remaining(&self, tenant: &str) -> u64 {
+        let used = *self.used.get(&key(tenant)).unwrap_or(&0);
+        self.limit.saturating_sub(used)
+    }
+}
